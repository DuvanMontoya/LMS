FROM python:3.13.13-slim-trixie@sha256:7ba5f5888fbe0014ab9edb2278922995c2201fc3752c46b0be24763eb46fa9f3 AS ffmpeg-build

ARG FFMPEG_VERSION=8.1.2
ARG FFMPEG_SIGNING_FINGERPRINT=FCF986EA15E6E293A5644F10B4322F04D67658D8
ARG LIBX264_VERSION=2:0.164.3108+git31e19f9-2+b1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        gnupg \
        libx264-dev="${LIBX264_VERSION}" \
        nasm \
        pkg-config \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/ffmpeg-build
RUN curl --fail --location --proto '=https' --tlsv1.2 \
        --output ffmpeg.tar.xz \
        "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" \
    && curl --fail --location --proto '=https' --tlsv1.2 \
        --output ffmpeg.tar.xz.asc \
        "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz.asc" \
    && curl --fail --location --proto '=https' --tlsv1.2 \
        --output ffmpeg-devel.asc \
        "https://ffmpeg.org/ffmpeg-devel.asc" \
    && gpg --batch --import ffmpeg-devel.asc \
    && test "$(gpg --batch --with-colons --fingerprint \
        "${FFMPEG_SIGNING_FINGERPRINT}" | awk -F: '$1 == "fpr" {print $10; exit}')" \
        = "${FFMPEG_SIGNING_FINGERPRINT}" \
    && gpg --batch --verify ffmpeg.tar.xz.asc ffmpeg.tar.xz \
    && tar --extract --file ffmpeg.tar.xz \
    && cd "ffmpeg-${FFMPEG_VERSION}" \
    && ./configure \
        --prefix=/opt/ffmpeg \
        --disable-debug \
        --disable-doc \
        --disable-network \
        --disable-autodetect \
        --disable-ffplay \
        --enable-ffmpeg \
        --enable-ffprobe \
        --enable-gpl \
        --enable-libx264 \
    && make -j"$(nproc)" \
    && make install \
    && /opt/ffmpeg/bin/ffmpeg -version \
    && /opt/ffmpeg/bin/ffprobe -version

FROM python:3.13.13-slim-trixie@sha256:7ba5f5888fbe0014ab9edb2278922995c2201fc3752c46b0be24763eb46fa9f3

ARG LIBX264_VERSION=2:0.164.3108+git31e19f9-2+b1

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/ffmpeg/bin:/workspace/apps/api/.venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libx264-164="${LIBX264_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10002 lms-media \
    && useradd --uid 10002 --gid 10002 --create-home \
        --shell /usr/sbin/nologin lms-media \
    && pip install --no-cache-dir uv==0.11.19 \
    && install -d -o 10002 -g 10002 -m 0700 /tmp/lms-assets

COPY --from=ffmpeg-build /opt/ffmpeg /opt/ffmpeg

WORKDIR /workspace/apps/api
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY --chown=10002:10002 apps/api ./
COPY --chown=10002:10002 schemas /workspace/schemas

USER 10002:10002

RUN ffmpeg -version && ffprobe -version

CMD ["celery", "-A", "config", "worker", "--loglevel=INFO", "--pool=prefork", "--concurrency=1", "--prefetch-multiplier=1", "--max-tasks-per-child=20", "--queues=media"]
