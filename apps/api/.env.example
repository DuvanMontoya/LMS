# Development-only placeholders. Never commit a real .env file.
# Local Compose generates the authoritative PostgreSQL values in
# infrastructure/local/.env; use the same names for native Django processes.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1
# Base URL of the separately delivered browser client. Required in production
# so neutral unknown-account mail can link to its signup route.
FRONTEND_ORIGIN=http://127.0.0.1:3000
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=replace-with-the-generated-local-infrastructure-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=60
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-the-generated-local-infrastructure-secret
# Redis database 1 is reserved for Django authentication cache and allauth rate limits.
REDIS_CACHE_DB=1
EMAIL_HOST=smtp.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=replace-in-production
EMAIL_HOST_PASSWORD=replace-in-production
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@lms.invalid
SERVER_EMAIL=no-reply@lms.invalid

# Prompt 16 integrations. Use generated local-only material; never commit real values.
# Example generation: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
INTEGRATIONS_MASTER_KEYS=local-2026-replace-with-base64-32-byte-key
INTEGRATIONS_ACTIVE_KEY_ID=local-2026
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/v1/integrations/google/callback/

# Academic assets. Local development uses LocalStack; production leaves both
# endpoints and explicit credentials empty so Boto3 uses AWS S3 and its normal
# role-based credential chain.
ASSET_S3_REGION=us-east-1
ASSET_S3_INTERNAL_ENDPOINT=http://127.0.0.1:4566
ASSET_S3_PUBLIC_ENDPOINT=http://127.0.0.1:4566
ASSET_S3_ACCESS_KEY_ID=test
ASSET_S3_SECRET_ACCESS_KEY=test
ASSET_S3_FORCE_PATH_STYLE=true
ASSET_QUARANTINE_BUCKET=lms-assets-quarantine
ASSET_PRIVATE_BUCKET=lms-assets-private
ASSET_S3_SERVER_SIDE_ENCRYPTION=AES256
ASSET_CLAMAV_HOST=127.0.0.1
ASSET_CLAMAV_PORT=3310

# Prompt 16 telemetry is opt-in locally and fail-closed when endpoints are absent.
NOTIFICATION_EMAIL_HMAC_KEY=replace-with-a-distinct-local-hmac-secret
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=lms-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
