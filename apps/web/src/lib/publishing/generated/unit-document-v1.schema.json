{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lms:content:unit-document:1",
  "title": "LMS unit academic document version 1",
  "description": "Portable canonical contract for one course unit academic document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "content"],
  "properties": {
    "type": { "const": "doc" },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/blockNode" }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "blockAttrs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId"],
      "properties": { "nodeId": { "$ref": "#/$defs/nodeId" } }
    },
    "inlineContent": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/inlineNode" }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "paragraph" },
        "attrs": { "$ref": "#/$defs/blockAttrs" },
        "content": { "$ref": "#/$defs/inlineContent" }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "heading" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "level"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "level": { "enum": [2, 3, 4] }
          }
        },
        "content": { "$ref": "#/$defs/inlineContent" }
      }
    },
    "bulletList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "bulletList" },
        "attrs": { "$ref": "#/$defs/blockAttrs" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/listItem" }
        }
      }
    },
    "orderedList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "orderedList" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "start"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "start": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/listItem" }
        }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "listItem" },
        "attrs": { "$ref": "#/$defs/blockAttrs" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/paragraph" },
              { "$ref": "#/$defs/heading" },
              { "$ref": "#/$defs/bulletList" },
              { "$ref": "#/$defs/orderedList" }
            ]
          }
        }
      }
    },
    "blockquote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "blockquote" },
        "attrs": { "$ref": "#/$defs/blockAttrs" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250,
          "items": { "$ref": "#/$defs/blockquoteChildNode" }
        }
      }
    },
    "horizontalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "horizontalRule" },
        "attrs": { "$ref": "#/$defs/blockAttrs" }
      }
    },
    "pedagogicalBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "pedagogicalBlock" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "kind"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "kind": {
              "enum": [
                "definition",
                "theorem",
                "lemma",
                "proposition",
                "corollary",
                "proof",
                "example",
                "counterexample",
                "remark",
                "warning",
                "summary"
              ]
            },
            "title": { "type": "string", "maxLength": 200 }
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250,
          "items": { "$ref": "#/$defs/pedagogicalChildNode" }
        }
      }
    },
    "displayMath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "displayMath" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "latex"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "latex": { "type": "string", "minLength": 1, "maxLength": 12000 },
            "label": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          }
        }
      }
    },
    "codeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "codeBlock" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "language", "code"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "language": {
              "enum": [
                "plaintext",
                "python",
                "javascript",
                "typescript",
                "json",
                "sql",
                "latex"
              ]
            },
            "code": { "type": "string", "maxLength": 50000 },
            "caption": { "type": "string", "maxLength": 300 }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "table" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "caption"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "caption": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/headerRow" },
              { "$ref": "#/$defs/bodyRow" }
            ]
          }
        }
      }
    },
    "headerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "tableRow" },
        "attrs": { "$ref": "#/$defs/blockAttrs" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/tableHeader" }
        }
      }
    },
    "bodyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "tableRow" },
        "attrs": { "$ref": "#/$defs/blockAttrs" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/tableCell" }
        }
      }
    },
    "tableHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "tableHeader" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "colspan", "rowspan", "colwidth"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "colspan": { "const": 1 },
            "rowspan": { "const": 1 },
            "colwidth": { "type": "null" }
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/paragraph" }
        }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "tableCell" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "colspan", "rowspan", "colwidth"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "colspan": { "const": 1 },
            "rowspan": { "const": 1 },
            "colwidth": { "type": "null" }
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/paragraph" }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "marks": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/mark" }
        }
      }
    },
    "inlineMath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "inlineMath" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "latex"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "latex": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      }
    },
    "hardBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "hardBreak" } }
    },
    "mark": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "bold" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "italic" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "code" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "attrs"],
          "properties": {
            "type": { "const": "link" },
            "attrs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["href"],
              "properties": {
                "href": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "title": { "type": "string", "maxLength": 300 }
              }
            }
          }
        }
      ]
    },
    "inlineNode": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/inlineMath" },
        { "$ref": "#/$defs/hardBreak" }
      ]
    },
    "blockquoteChildNode": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/bulletList" },
        { "$ref": "#/$defs/orderedList" },
        { "$ref": "#/$defs/horizontalRule" },
        { "$ref": "#/$defs/pedagogicalBlock" },
        { "$ref": "#/$defs/displayMath" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/table" }
      ]
    },
    "pedagogicalChildNode": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/bulletList" },
        { "$ref": "#/$defs/orderedList" },
        { "$ref": "#/$defs/blockquote" },
        { "$ref": "#/$defs/horizontalRule" },
        { "$ref": "#/$defs/displayMath" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/table" }
      ]
    },
    "blockNode": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/bulletList" },
        { "$ref": "#/$defs/orderedList" },
        { "$ref": "#/$defs/blockquote" },
        { "$ref": "#/$defs/horizontalRule" },
        { "$ref": "#/$defs/pedagogicalBlock" },
        { "$ref": "#/$defs/displayMath" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/table" }
      ]
    }
  }
}
