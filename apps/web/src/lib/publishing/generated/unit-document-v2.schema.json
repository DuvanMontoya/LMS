{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lms:content:unit-document:2",
  "title": "LMS unit academic document version 2",
  "description": "Canonical semantic unit content with immutable academic asset references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "content"],
  "properties": {
    "type": { "const": "doc" },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "nodeId": { "type": "string", "format": "uuid" },
    "assetVersionId": { "type": "string", "format": "uuid" },
    "plainText": { "type": "string", "maxLength": 10000 },
    "legacyNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "not": {
            "enum": [
              "imageAsset",
              "audioAsset",
              "videoAsset",
              "documentAsset",
              "datasetAsset"
            ]
          }
        },
        "attrs": { "type": "object" },
        "content": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/node" }
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "marks": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "object" }
        }
      }
    },
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "imageAsset" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeId",
            "assetVersionId",
            "altText",
            "decorative",
            "caption",
            "displaySize"
          ],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "assetVersionId": { "$ref": "#/$defs/assetVersionId" },
            "altText": { "type": "string", "maxLength": 500 },
            "decorative": { "type": "boolean" },
            "caption": { "$ref": "#/$defs/plainText" },
            "displaySize": { "enum": ["small", "medium", "large", "full"] }
          },
          "allOf": [
            {
              "if": {
                "properties": { "decorative": { "const": true } },
                "required": ["decorative"]
              },
              "then": {
                "properties": {
                  "altText": { "type": "string", "maxLength": 0 }
                }
              },
              "else": {
                "properties": {
                  "altText": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        }
      }
    },
    "audioAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "audioAsset" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeId",
            "assetVersionId",
            "title",
            "transcript",
            "caption"
          ],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "assetVersionId": { "$ref": "#/$defs/assetVersionId" },
            "title": { "type": "string", "minLength": 1, "maxLength": 300 },
            "transcript": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "caption": { "$ref": "#/$defs/plainText" }
          }
        }
      }
    },
    "videoAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "videoAsset" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeId",
            "assetVersionId",
            "title",
            "transcript",
            "caption",
            "silent"
          ],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "assetVersionId": { "$ref": "#/$defs/assetVersionId" },
            "captionsAssetVersionId": { "$ref": "#/$defs/assetVersionId" },
            "title": { "type": "string", "minLength": 1, "maxLength": 300 },
            "transcript": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "caption": { "$ref": "#/$defs/plainText" },
            "silent": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "silent": { "const": false } },
                "required": ["silent"]
              },
              "then": {
                "properties": {
                  "captionsAssetVersionId": { "$ref": "#/$defs/assetVersionId" }
                },
                "required": ["captionsAssetVersionId"]
              }
            }
          ]
        }
      }
    },
    "downloadAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "enum": ["documentAsset", "datasetAsset"] },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId", "assetVersionId", "label", "description"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/nodeId" },
            "assetVersionId": { "$ref": "#/$defs/assetVersionId" },
            "label": { "type": "string", "minLength": 1, "maxLength": 300 },
            "description": { "$ref": "#/$defs/plainText" }
          }
        }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/imageAsset" },
        { "$ref": "#/$defs/audioAsset" },
        { "$ref": "#/$defs/videoAsset" },
        { "$ref": "#/$defs/downloadAsset" },
        { "$ref": "#/$defs/legacyNode" }
      ]
    }
  }
}
