{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lms:assessment:assessment-version:1",
  "title": "Assessment version public snapshot v1",
  "type": "object",
  "required": [
    "schema_version",
    "assessment",
    "settings",
    "objectives",
    "sections"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "assessment": {
      "type": "object",
      "required": ["id", "slug", "title", "description"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "required": [
        "time_limit_minutes",
        "attempt_limit",
        "pass_basis_points",
        "shuffle_sections",
        "shuffle_items",
        "feedback_mode"
      ],
      "properties": {
        "time_limit_minutes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 10080
        },
        "attempt_limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 20
        },
        "pass_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "shuffle_sections": { "type": "boolean" },
        "shuffle_items": { "type": "boolean" },
        "feedback_mode": {
          "enum": ["none", "score_only", "full_after_grading"]
        }
      },
      "additionalProperties": false
    },
    "objectives": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/objective" }
    },
    "sections": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "title", "instructions", "position", "items"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "instructions": { "type": "string", "maxLength": 5000 },
          "position": { "type": "integer", "minimum": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "required": [
                "id",
                "question_version_id",
                "position",
                "points",
                "required",
                "question",
                "objectives"
              ],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "question_version_id": { "type": "string", "format": "uuid" },
                "position": { "type": "integer", "minimum": 1 },
                "points": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$"
                },
                "required": { "type": "boolean" },
                "question": { "$ref": "urn:lms:assessment:question-public:1" },
                "objectives": {
                  "type": "array",
                  "maxItems": 100,
                  "items": { "$ref": "#/$defs/objective" }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "pools": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "instructions",
          "position",
          "selection_count",
          "points_per_item",
          "selection_strategy",
          "shuffle_selected",
          "candidates"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "instructions": { "type": "string", "maxLength": 5000 },
          "position": { "type": "integer", "minimum": 1 },
          "selection_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "points_per_item": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$"
          },
          "selection_strategy": { "const": "random_without_replacement" },
          "shuffle_selected": { "type": "boolean" },
          "candidates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": ["id", "question_version_id", "position", "question"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "question_version_id": { "type": "string", "format": "uuid" },
                "position": { "type": "integer", "minimum": 1 },
                "question": { "$ref": "urn:lms:assessment:question-public:1" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "objective": {
      "type": "object",
      "required": ["id", "code", "statement"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1200 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
