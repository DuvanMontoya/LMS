{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lms:assessment:question-definition:1",
  "title": "Question definition v1",
  "type": "object",
  "required": ["schema_version", "type", "public", "grading", "feedback"],
  "properties": {
    "schema_version": { "const": 1 },
    "type": {
      "enum": [
        "single_choice",
        "multiple_choice",
        "true_false",
        "numeric",
        "short_text",
        "long_text",
        "ordering",
        "matching",
        "mathematical_expression"
      ]
    },
    "public": { "$ref": "urn:lms:assessment:question-public:1" },
    "authoring": { "$ref": "#/$defs/authoring" },
    "worked_solution": { "$ref": "urn:lms:content:unit-document:2" },
    "grading": {
      "type": "object",
      "properties": {
        "correct_option_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "correct_value": { "$ref": "#/$defs/decimal" },
        "tolerance": { "$ref": "#/$defs/non_negative_decimal" },
        "accepted_answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 2000 }
        },
        "case_sensitive": { "type": "boolean" },
        "correct_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "correct_pairs": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "propertyNames": { "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
          "additionalProperties": { "$ref": "#/$defs/identifier" }
        },
        "correct_boolean": { "type": "boolean" },
        "manual_required": { "const": true },
        "rubric": { "type": "string", "maxLength": 10000 },
        "expected_mathjson": {},
        "equivalence_strategy": {
          "enum": ["structural", "symbolic_common_domain"]
        },
        "symbol_assumptions": { "type": "object", "maxProperties": 10 },
        "allowed_symbols": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          }
        },
        "allowed_functions": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["Sin", "Cos", "Tan", "Exp", "Ln", "Log", "Abs"] }
        }
      },
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "general": { "type": "string", "maxLength": 5000 },
        "correct": { "type": "string", "maxLength": 5000 },
        "incorrect": { "type": "string", "maxLength": 5000 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "public": { "properties": { "type": { "$ref": "#/properties/type" } } }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "enum": ["single_choice", "multiple_choice"] }
        },
        "required": ["type"]
      },
      "then": {
        "properties": { "grading": { "required": ["correct_option_ids"] } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "true_false" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "grading": { "required": ["correct_boolean"] } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "numeric" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "grading": { "required": ["correct_value", "tolerance"] }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "short_text" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "grading": { "required": ["accepted_answers", "case_sensitive"] }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "long_text" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "grading": { "required": ["manual_required"] } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "ordering" } },
        "required": ["type"]
      },
      "then": { "properties": { "grading": { "required": ["correct_order"] } } }
    },
    {
      "if": {
        "properties": { "type": { "const": "matching" } },
        "required": ["type"]
      },
      "then": { "properties": { "grading": { "required": ["correct_pairs"] } } }
    },
    {
      "if": {
        "properties": { "type": { "const": "mathematical_expression" } },
        "required": ["type"]
      },
      "then": { "$ref": "urn:lms:assessment:math-expression:1" }
    }
  ],
  "$defs": {
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework": {
          "enum": ["icfes", "higher_education", "research", "other"]
        },
        "difficulty": {
          "enum": ["foundational", "intermediate", "advanced", "expert"]
        },
        "cognitive_process": {
          "enum": ["understand", "apply", "analyze", "evaluate", "create"]
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "source_note": { "type": "string", "maxLength": 2000 },
        "choice_rationales": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": { "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
          "additionalProperties": { "type": "string", "maxLength": 3000 }
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,99})(\\.[0-9]{1,20})?$"
    },
    "non_negative_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,99})(\\.[0-9]{1,20})?$"
    }
  },
  "additionalProperties": false
}
