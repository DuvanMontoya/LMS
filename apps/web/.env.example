# URL interna exclusiva del servidor Next.js hacia Django. No usar NEXT_PUBLIC_.
DJANGO_INTERNAL_ORIGIN=http://127.0.0.1:8000
# Nombre de la cookie de sesión Django, usado únicamente por proxy.ts de forma optimista.
AUTH_SESSION_COOKIE_NAME=sessionid
# Origen público WSS de LiveKit, sin path ni credenciales. Proxy lo usa para
# limitar connect-src exclusivamente en /organizaciones/<slug>/clases/<id>.
NEXT_PUBLIC_LIVEKIT_URL=wss://live.your-domain.example

# Portal privado de autoría de MediaCMS. Sólo abre la herramienta de quien
# diseña el vídeo; nunca es una URL de entrega para estudiantes. En local usa
# el portal aislado levantado por `pnpm mediacms:up`.
NEXT_PUBLIC_MEDIACMS_AUTHORING_URL=http://127.0.0.1:8091

# Error reporting remains disabled when DSNs are absent. Never expose a server
# DSN through NEXT_PUBLIC_ unless it is intentionally the browser project DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
