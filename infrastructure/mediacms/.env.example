# Copying this file is not enough: run `pnpm mediacms:init` to create a private
# .local/mediacms/.env with random secrets and the absolute source path.
COMPOSE_PROJECT_NAME=lms-mediacms
MEDIACMS_SOURCE_DIR=C:/absolute/path/to/.local/mediacms/mediacms-v8.1.3
MEDIACMS_PORT=8091
MEDIACMS_POSTGRES_DB=mediacms
MEDIACMS_POSTGRES_USER=mediacms
MEDIACMS_POSTGRES_PASSWORD=replace-with-a-random-secret
MEDIACMS_REDIS_PASSWORD=replace-with-a-random-secret
MEDIACMS_SECRET_KEY=replace-with-a-django-secret
MEDIACMS_ADMIN_USER=mediacms-admin
MEDIACMS_ADMIN_EMAIL=mediacms-admin@localhost.test
MEDIACMS_ADMIN_PASSWORD=replace-with-a-random-secret
