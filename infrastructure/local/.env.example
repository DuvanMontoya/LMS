# Generated local values belong in .env, never in Git.
COMPOSE_PROJECT_NAME=lms

POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=replace-with-a-cryptographically-random-local-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-cryptographically-random-local-secret
# Reserved for Django cache and django-allauth rate-limit keys; Redis database 0 remains infrastructure-owned.
REDIS_CACHE_DB=1
# Dedicated Celery broker database; durable job state remains in PostgreSQL.
CELERY_BROKER_DB=2

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
ASSET_QUARANTINE_BUCKET=lms-assets-quarantine
ASSET_PRIVATE_BUCKET=lms-assets-private

# Local-only Grafana credentials. Generate distinct values in ignored .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-cryptographically-random-local-secret
