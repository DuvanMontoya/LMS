# Generated local values belong in .env, never in Git.
COMPOSE_PROJECT_NAME=lms

# Operador local de plataforma. Sólo se sincroniza en DEBUG y nunca recibe
# membresía institucional implícita. Los valores reales viven en .env ignorado.
LMS_LOCAL_PLATFORM_OPERATOR_EMAIL=operator@example.local
LMS_LOCAL_PLATFORM_OPERATOR_PASSWORD=replace-with-a-strong-local-password
LMS_LOCAL_PLATFORM_OPERATOR_FIRST_NAME=Platform
LMS_LOCAL_PLATFORM_OPERATOR_LAST_NAME=Operator

POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=replace-with-a-cryptographically-random-local-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-cryptographically-random-local-secret
# Reserved for Django cache and django-allauth rate-limit keys; Redis database 0 remains infrastructure-owned.
REDIS_CACHE_DB=1
# Dedicated Celery broker database; durable job state remains in PostgreSQL.
CELERY_BROKER_DB=2

# Email stays file-backed by default. Set smtp and provide the private Resend
# key only in the ignored .env when testing real delivery.
EMAIL_DELIVERY_MODE=file
ACCOUNT_EMAIL_SUBJECT_PREFIX=[Plataforma Académica] 
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=replace-with-a-private-resend-api-key
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Plataforma Académica <cuentas@papyros.pro>
SERVER_EMAIL=Plataforma Académica <cuentas@papyros.pro>
EMAIL_MESSAGE_ID_DOMAIN=papyros.pro

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
ASSET_QUARANTINE_BUCKET=lms-assets-quarantine
ASSET_PRIVATE_BUCKET=lms-assets-private

# Local-only Grafana credentials. Generate distinct values in ignored .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-cryptographically-random-local-secret

# LiveKit OSS local; setup-local-infrastructure.ps1 generates distinct secrets.
LIVEKIT_ENABLED=true
LIVEKIT_URL=ws://127.0.0.1:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace-with-a-random-local-api-key
LIVEKIT_API_SECRET=replace-with-a-cryptographically-random-local-secret
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:8010/api/v1/livekit/webhook/
LIVEKIT_EGRESS_ENABLED=true
